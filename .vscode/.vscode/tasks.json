{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build and Run C++ (GCC)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"g++ -std=c++23 \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" && \"${fileDirname}\\${fileBasenameNoExtension}.exe\""
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$gcc"
			]
		}
	]
}